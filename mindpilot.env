# 项目根目录
PROJECT_ROOT=/root/autodl-tmp/MindPilot
# open_clip 权重
OPEN_CLIP_WEIGHTS=${PROJECT_ROOT}/open_clip_pytorch_model.bin
# 测试集200张图片
TEST_IMAGE_DIR=${PROJECT_ROOT}/data/things-eeg2/test_images_flat
# 测试集中的图片对应的 CLIP嵌入特征
CLIP_EMBED_DIR=${PROJECT_ROOT}/data/things-eeg2/clip_image_embeds

# test image下载地址（未解压）
THINGS_EEG2_TEST_IMAGE_DIR=${PROJECT_ROOT}/data/things-eeg2/test_images/test_images

# EEG 特征模型，将EEG 映射到 CLIP 特征空间
EEG2CLIP_ENCODING_MODEL_PATH=${PROJECT_ROOT}/data/sub_model/sub-01/diffusion_250hz/ATM_S_reconstruction_scale_0_1000_40.pth
# 图像到 EEG 模型，将图像映射到 EEG 特征空间
IMG2EEG_MODEL_PATH=${PROJECT_ROOT}/data/encoding_models_checkpoints/sub-01/synthetic_eeg_data/encoding-end_to_end/dnn-alexnet/modeled_time_points-all/pretrained-True/lr-1e-05__wd-0e+00__bs-064/model_state_dict.pt

# 结果目录
OUTPUT_DIR=${PROJECT_ROOT}/benchmark_results
# benchmark_offline_generation 结果路径
BENCHMARK_OFFLINE_OUTPUT_DIR=${OUTPUT_DIR}/benchmark_offline_generation
# benchmark_framework_total 结果路径
BENCHMARK_TOTAL_OUTPUT_DIR=${OUTPUT_DIR}/benchmark_framework_total
# benchmark_heuristic_generation 结果路径
BENCHMARK_HEURISTIC_OUTPUT_DIR=${OUTPUT_DIR}/benchmark_heuristic_generation
